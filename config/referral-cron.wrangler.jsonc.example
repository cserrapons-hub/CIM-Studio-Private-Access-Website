{
  "name": "cim-referral-cron-preview",
  "main": "../workers/referral-cron.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "FORMS_DB",
    "database_name": "REPLACE_WITH_D1_NAME",
    "database_id": "REPLACE_WITH_D1_ID"
  }],
  "vars": {
    "REFERRALS_ENABLED": "false",
    "REFERRALS_AUTOMATION_ENABLED": "false",
    "NEWSLETTER_ORIGIN": "https://cimstudio.es",
    "GETRESPONSE_CAMPAIGN_ID": "PL6jh"
  }
}
