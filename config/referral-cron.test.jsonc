{
  "name": "cim-referral-cron-test",
  "main": "../workers/referral-cron.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "FORMS_DB",
    "database_name": "cim-referrals-test",
    "database_id": "8024c2a7-a52b-4faf-840d-9e72e3089021",
    "jurisdiction": "eu"
  }],
  "vars": {
    "REFERRALS_ENABLED": "true",
    "REFERRALS_AUTOMATION_ENABLED": "true",
    "REFERRALS_TEST_MODE": "true",
    "CONTROLLED_TEST_MODE": "true",
    "SITE_LIVE": "false",
    "CONTROLLED_TEST_ORIGIN": "https://cim-referrals-test.pages.dev",
    "NEWSLETTER_ORIGIN": "https://cim-referrals-test.pages.dev",
    "CAJITA_TEST_ORIGIN": "https://cim-referrals-test.pages.dev",
    "CONTROLLED_TEST_USER": "cim-test",
    "GETRESPONSE_CAMPAIGN_ID": "vL5hH",
    "GETRESPONSE_SUBSCRIBER_TYPE_FIELD_ID": "njdbT6",
    "MAIL_FROM": "CIM Studio Pruebas <recomendaciones@referral-test.cimstudio.es>"
  }
}
