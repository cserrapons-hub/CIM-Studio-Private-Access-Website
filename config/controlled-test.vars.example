# Dedicated Cloudflare preview project ONLY. Import manually after authorization.
# Never copy filled values to Git, public/, logs or Production configuration.
CONTROLLED_TEST_MODE=true
CONTROLLED_TEST_ORIGIN=
CONTROLLED_TEST_USER=
# SECRET: random >=32 characters, Basic login over HTTPS only.
CONTROLLED_TEST_PASSWORD=
FORMS_ENABLED=false
NEWSLETTER_ENABLED=false
SAMPLES_ENABLED=false
CAREERS_ENABLED=false
FORMS_VERIFIED=false
FOUNDERS_RECORDING_VERIFIED=false
SITE_LIVE=false
GETRESPONSE_WEBHOOK_ENABLED=false
GETRESPONSE_WEBHOOK_GRANTS_ENABLED=false
GETRESPONSE_WEBHOOK_IPS_REVIEWED=false
GETRESPONSE_API_KEY=
# Verify actual v3 campaignId; never infer from form UUID, panel ID or token.
GETRESPONSE_CAMPAIGN_ID=
GETRESPONSE_WEBHOOK_CIDRS=
GETRESPONSE_WEBHOOK_BEARER_SECRET=
AUDIT_HASH_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CIM_PRODUCTION_DELIVERY_ENABLED=false
# STAGING Render HTTPS origin ONLY; never the live customer database.
CIM_PRODUCTION_URL=
CIM_PRODUCTION_KEY_ID=
CIM_PRODUCTION_HMAC_SECRET=
OUTBOX_ENCRYPTION_KEY=
OUTBOX_MAX_PENDING_SECONDS=
OUTBOX_RECEIPT_SECONDS=
OUTBOX_RECONCILIATION_REVIEWED=false

# Independent sample/career registration stores and transactional receipts.
# CAREERS_DB must be a different D1 database from FORMS_DB.
REGISTRATION_ORIGIN=
REGISTRATIONS_STORAGE_REVIEWED=false
REGISTRATIONS_TEST_ENABLED=false
REGISTRATION_REVIEW_DAYS=
SAMPLES_DATA_KEY=
CAREERS_DATA_KEY=
SAMPLES_VERIFIED=false
CAREERS_VERIFIED=false
MAIL_RECEIPTS_VERIFIED=false
MAIL_WORKER_ENABLED=false

# Transactional mail: reuse only in authorised test environment.
RESEND_API_KEY=
MAIL_FROM=

# Local newsletter evidence preparation ONLY; no public route enabled.
NEWSLETTER_PREPARATION_ENABLED=false
# Dedicated SECRET: AES-256 base64, do not reuse samples/career keys.
NEWSLETTER_DATA_KEY=

# Restricted /api/controlled/subscribe ONLY; keep false until authorised.
NEWSLETTER_CONTROLLED_SEND_ENABLED=false
# Dedicated SECRET: 32 random bytes encoded as Base64; never reuse AUDIT_HASH_SECRET.
NEWSLETTER_TEST_ALLOWLIST_SECRET=
# HMAC-SHA256(UTF-8 Base64 secret TEXT, 'newsletter-test-allowlist:v1:' + normalised email).
# Calculate privately; never place the email or either secret in this file.
NEWSLETTER_TEST_EMAIL_HASH=

# Independent private-test policy approval AND reviewed code version required.
# This never approves legal/content.js or enables public newsletter acquisition.
NEWSLETTER_TEST_LEGAL_APPROVED=false

# Read-only private controls. Remain false until separately authorised.
NEWSLETTER_OBSERVATIONS_ENABLED=false
CONTROLLED_REVIEW_ENABLED=false
# Future public newsletter: source contract + public legal approval also required.
NEWSLETTER_PUBLIC_ENABLED=false
NEWSLETTER_VERIFIED=false
NEWSLETTER_EVIDENCE_REVIEWED=false
NEWSLETTER_ORIGIN=

# Independent private sample/career policy gates; never public legal approval.
SAMPLES_TEST_LEGAL_APPROVED=false
CAREERS_TEST_LEGAL_APPROVED=false

# Keep false until GetResponse API double opt-in behaviour is reviewed.
NEWSLETTER_API_REVIEWED=false
